# Copy this file to .env (ignored by git) and adjust values for local development.
# These are local-only PostgreSQL credentials consumed by docker-compose.yml.
# They must NOT be committed with real values.

# Inventory.Api database (container inventory-db)
# Host port 5432 is occupied by a native PostgreSQL installation on this
# machine, so the container is published on 5434 instead.
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change-me
INVENTORY_DB_PORT=5434

# Billing.Api database (container billing-db)
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change-me
BILLING_DB_PORT=5433
